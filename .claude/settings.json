{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(go mod tidy:*)",
      "Bash(go work:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(buf:*)",
      "Bash(npm run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(go get:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "gofmt -w paratech/desktop paratech/hub paratech/shared 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
