{
  "name": "paratech-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"build/test/*.test.js\"",
    "e2e": "tsc -p tsconfig.json && node build/src/cli.js",
    "e2e:live": "tsc -p tsconfig.json && node build/src/cli.js --live",
    "fetch-model": "tsc -p tsconfig.json && node build/scripts/fetch-model.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
