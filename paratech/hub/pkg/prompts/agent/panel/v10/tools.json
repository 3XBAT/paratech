{
  "catalog_version": 10,
  "types": {
    "id": "opaque desktop ID",
    "ids": "list of IDs, each as id",
    "date": "date YYYY-MM-DD in the student's time zone",
    "time": "time of day HH:MM, 24 h; only together with due",
    "enum": "one of values",
    "bool": "true or false",
    "label": "short text, at most 80 characters",
    "query": "the student's own words, one line, at most 500 characters",
    "text": "UI card text, at most 300 characters, no HTML",
    "reply_text": "plain text without HTML or Markdown, at most 4000 characters; paragraphs separated by an empty line; a longer reply is cut at a sentence",
    "text_list": "list of text",
    "card_ids": "list of 0-10 IDs, each as id, that a card shows as a list; the desktop draws their titles and dates from local data, the model never writes them",
    "plan_steps": "planned calls: tool name plus argument IDs, rendered by desktop templates",
    "questions": "questions of a card: kind choice|text, options as text, default option index"
  },
  "notes": {
    "agent_can_execute": "false means the planner still calls the tool, but the call only creates a proposal card; nothing happens until the student clicks it",
    "one_of": "optional argument groups of make_summary (recording|material), find_homework (recording|material), triage_assignment (assignment|upload|topic), place_upload (folder|lesson) and list_notes (lesson|subject) take exactly one of the group; the desktop parser enforces it (TASK-115) and the Hub refuses a returned call that breaks it (catalog 4)",
    "max_items": "an ids argument takes 1-20 IDs unless it states max_items (catalog 10: mark_assignments_done.assignments, 1-50)",
    "actions": "the action enum of change_assignment, note, recording and offer_button selects what the call does; each action takes only its own arguments (desktop values/wave10.go: edit needs one field, delete and restore only the assignment; add_text needs text and one of note|lesson|date; offer_button takes exactly the ID its action needs) and set_setting takes only a value of that setting; the desktop refuses any other combination as an is_error result, the Hub checks the schema only"
  },
